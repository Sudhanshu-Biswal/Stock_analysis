# Copy to .env and fill in real values. .env is gitignored -- never commit secrets.

# "anthropic" (default) or "openai" -- picks which SDK/key is used below.
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic.
# Verify your Claude plan includes Messages API credits at support.claude.com / docs.claude.com --
# the Claude.ai subscription and the API are not automatically the same billing pool.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Only needed if you get a 400 "anthropic-workspace-id is required" error --
# happens with identity-linked keys created under an org workspace. Find it
# in the console.anthropic.com URL for your workspace, or generate a plain
# API key instead at console.anthropic.com/settings/keys to avoid this.
ANTHROPIC_WORKSPACE_ID=

# Required if LLM_PROVIDER=openai. Get a key at platform.openai.com/api-keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional override
PHASE1_API_BASE=http://127.0.0.1:8000
